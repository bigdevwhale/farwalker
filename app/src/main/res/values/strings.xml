    <string name="o_title">Farwalker</string>
    <string name="o_text">Your steps carry a traveller across the real map of the world: along its roads, over its borders, across its seas.\n\nEvery kilometre walked earns a coin for a train or a ship. The world is big: this is a journey of years.</string>
    <string name="o_next">Next</string>
    <string name="o_home">Where do you set out from?</string>
    <string name="o_home_hint">Your town or the nearest big one</string>
    <string name="o_steps">The phone counts your steps</string>
    <string name="o_steps_text">The app reads the phone\'s own step counter. Nothing leaves the phone except the traveller\'s coordinates, sent for the weather where they are.</string>
    <string name="o_height">Your height, so the steps turn into the right number of km</string>
    <string name="o_allow">Allow step counting</string>
    <string name="o_start">Set out</string>
    <string name="o_no_sensor">This phone has no step counter. Steps can still be added by hand in the settings.</string>

